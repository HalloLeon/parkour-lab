# Operating system
.DS_Store

# Local agent workspace
.agent/

# IDEs and editors
**/.idea/
**/.vscode/
# Keep the top-level .vscode directory for shared VS Code settings.
!.vscode

# Python
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc

# Native builds
**/cmake-build*/
**/build*/
**/*.so

# Isaac Sim and Omniverse
_isaac_sim*
_repo
_build
.lastformat
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Generated files and documentation
**/*.pb
**/docs/_build/*
**/generated/*

# Experiment outputs
**/output/*
**/outputs/*
**/runs/*
**/logs/*
**/recordings/*
**/videos/*
**/wandb/*
**/.neptune/*

# Datasets and pretrained checkpoints
/datasets/
/.pretrained_checkpoints/

# Containers
**/*.sif
docker/.container.cfg
docker/artifacts/
docker/cluster/exports/
.isaac-lab-docker-history

# Logs and temporary files
**/*.log*
*.tmp
