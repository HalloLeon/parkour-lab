# ignore .git related folders
.git/
.github/
.gitignore
# Local planning records and machine state are not deployment inputs.
.agent/
.agents/
.codex/
.vscode/
**/.DS_Store
# ignore docs
docs/
# ignore logs
**/logs/
**/runs/
**/output/*
**/outputs/*
**/videos/*
*.tmp
# ignore docker
docker/cluster/exports/
docker/.container.cfg
# ignore recordings
recordings/
# ignore __pycache__
**/__pycache__/
**/*.egg-info/
# ignore isaac sim symlink
_isaac_sim?
# Docker history
docker/.isaac-lab-docker-history
